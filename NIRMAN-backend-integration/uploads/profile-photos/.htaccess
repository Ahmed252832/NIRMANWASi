Options -Indexes

<FilesMatch "\.(?i:php|phtml|phar|cgi|pl|py|jsp|asp|aspx|shtml)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .jsp .asp .aspx .shtml
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .jsp .asp .aspx .shtml
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
